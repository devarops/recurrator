FROM evaristor/recurrator:latest

# qed verification tool. Nothing is pinned: elan installs the Lean toolchain
# that qed's lean-toolchain file asks for, and qed comes from its main branch.
RUN apt-get update && apt-get install --yes curl git && rm -rf /var/lib/apt/lists/*
RUN curl https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -sSf | sh -s -- -y
RUN . "$HOME/.elan/env" && git clone https://github.com/tskovlund/qed.git /opt/qed && cd /opt/qed && lake build
RUN ln -sf /opt/qed/.lake/build/bin/qed /usr/local/bin/qed

CMD ["bash"]
